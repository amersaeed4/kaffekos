a:3:{s:7:"headers";a:21:{s:34:"798f3c3dcfdedb97d3df461a657d4a4fsc";a:4:{s:5:"title";s:7:"Contact";s:6:"banner";a:2:{s:7:"eyebrow";s:7:"Kontakt";s:8:"subtitle";s:73:"Questions, bookings or just saying hello? We would love to hear from you.";}s:7:"contact";a:4:{s:10:"form_title";s:17:"Send us a message";s:10:"form_intro";s:30:"We usually reply within a day.";s:10:"info_title";s:7:"Find us";s:8:"show_map";b:1;}s:4:"form";a:4:{s:4:"name";s:7:"contact";s:6:"fields";a:6:{s:4:"name";a:3:{s:5:"label";s:9:"Your name";s:4:"type";s:4:"text";s:8:"validate";a:1:{s:8:"required";b:1;}}s:5:"email";a:3:{s:5:"label";s:5:"Email";s:4:"type";s:5:"email";s:8:"validate";a:1:{s:8:"required";b:1;}}s:5:"phone";a:2:{s:5:"label";s:16:"Phone (optional)";s:4:"type";s:4:"text";}s:7:"subject";a:4:{s:5:"label";s:17:"What is it about?";s:4:"type";s:6:"select";s:7:"default";s:7:"General";s:7:"options";a:4:{s:7:"General";s:16:"General question";s:11:"Reservation";s:17:"Table reservation";s:6:"Events";s:18:"Events or catering";s:8:"Feedback";s:8:"Feedback";}}s:7:"message";a:4:{s:5:"label";s:7:"Message";s:4:"type";s:8:"textarea";s:4:"rows";i:6;s:8:"validate";a:1:{s:8:"required";b:1;}}s:8:"honeypot";a:1:{s:4:"type";s:8:"honeypot";}}s:7:"buttons";a:1:{s:6:"submit";a:2:{s:4:"type";s:6:"submit";s:5:"value";s:12:"Send message";}}s:7:"process";a:4:{i:0;a:1:{s:4:"save";a:4:{s:10:"fileprefix";s:8:"message-";s:10:"dateformat";s:7:"Ymd-His";s:9:"extension";s:3:"txt";s:4:"body";s:35:"{% include 'forms/data.txt.twig' %}";}}i:1;a:1:{s:5:"email";a:3:{s:7:"subject";s:74:"[Kaffekos website] {{ form.value.subject|e }} from {{ form.value.name|e }}";s:4:"body";s:36:"{% include 'forms/data.html.twig' %}";s:8:"reply_to";s:22:"{{ form.value.email }}";}}i:2;a:1:{s:7:"message";s:80:"Tusen takk! Thank you, your message has been sent. We will get back to you soon.";}i:3;a:1:{s:5:"reset";b:1;}}}}s:34:"8ab86220529ffe3860b821622bbcc306sc";a:3:{s:5:"title";s:7:"Gallery";s:11:"media_order";s:405:"exterior-night.jpg, pastry-display.jpg, cappuccino-and-cake.jpg, interior-mezzanine.jpg, iced-latte.jpg, interior-lounge.jpg, exterior-evening.jpg, coffee-and-bites.jpg, interior-window.jpg, snack-platter.jpg, exterior-purple-lights.jpg, interior-shelf.jpg, frappe.jpg, pastry-plate.jpg, coffee-beans-can.jpg, chess-night.jpg, interior-seating.jpg, coffee-bean-shelf.jpg, exterior-path.jpg, coffee-tin.jpg";s:6:"banner";a:2:{s:7:"eyebrow";s:7:"Galleri";s:8:"subtitle";s:27:"A look at life at Kaffekos.";}}s:34:"3d39a2b83546d23781c0e6baeacc011fsc";a:6:{s:5:"title";s:9:"Our Story";s:4:"menu";s:5:"About";s:6:"banner";a:2:{s:7:"eyebrow";s:18:"Om oss · About us";s:8:"subtitle";s:44:"A Norwegian-inspired coffee house in Lahore.";}s:11:"story_image";s:18:"story-interior.jpg";s:6:"values";a:2:{s:5:"title";s:17:"What we stand for";s:5:"items";a:4:{i:0;a:3:{s:4:"icon";s:3:"cup";s:5:"title";s:13:"Honest coffee";s:4:"text";s:80:"Carefully crafted drinks with rich aroma, smooth taste and refined presentation.";}i:1;a:3:{s:4:"icon";s:5:"heart";s:5:"title";s:3:"Kos";s:4:"text";s:81:"Warmth, comfort and good company, the Norwegian art of cosiness, in every corner.";}i:2;a:3:{s:4:"icon";s:4:"leaf";s:5:"title";s:14:"Simple & clean";s:4:"text";s:78:"Nordic design: calm, uncluttered and made to last, from our cups to our space.";}i:3;a:3:{s:4:"icon";s:5:"users";s:5:"title";s:9:"Community";s:4:"text";s:73:"A place for Lahore to gather, work, celebrate or simply catch its breath.";}}}s:4:"team";a:4:{s:7:"enabled";b:0;s:5:"title";s:29:"The people behind the counter";s:8:"subtitle";s:0:"";s:7:"members";a:0:{}}}s:34:"c709614d226f485c3fcbd5385a7986c5sc";a:11:{s:5:"title";s:4:"Home";s:4:"hero";a:10:{s:5:"image";s:15:"hero-facade.jpg";s:5:"focus";s:3:"60%";s:7:"eyebrow";s:32:"Norwegian Coffee House · Lahore";s:5:"title";s:32:"Nordic warmth, brewed in Lahore.";s:8:"subtitle";s:131:"Premium Hausbrandt coffee, warm hospitality and a relaxed Scandinavian café feel. A little piece of Norway in the heart of Lahore.";s:10:"btn1_label";s:18:"Explore the menu >";s:8:"btn1_url";s:5:"/menu";s:10:"btn2_label";s:7:"Find us";s:8:"btn2_url";s:8:"/contact";s:15:"show_open_badge";b:1;}s:5:"intro";a:9:{s:7:"enabled";b:1;s:7:"eyebrow";s:9:"Velkommen";s:5:"title";s:19:"Welcome to Kaffekos";s:4:"text";s:341:"In Norway, **kos** is the feeling of warmth, comfort and good company. It is a candle on the table, a hot cup in your hands and nowhere else to be.

Kaffekos brings that feeling to Lahore: carefully crafted coffee with rich aroma and smooth taste, simple Nordic-inspired bites, and a calm, clean space where friends and family can slow down.";s:5:"image";s:20:"welcome-interior.jpg";s:6:"image2";s:22:"welcome-cappuccino.jpg";s:10:"link_label";s:14:"Read our story";s:8:"link_url";s:6:"/about";s:5:"stats";a:3:{i:0;a:2:{s:5:"value";s:6:"Norway";s:5:"label";s:15:"our inspiration";}i:1;a:2:{s:5:"value";s:6:"Lahore";s:5:"label";s:8:"our home";}i:2;a:2:{s:5:"value";s:6:"4.8★";s:5:"label";s:22:"on Google (83 reviews)";}}}s:6:"coffee";a:10:{s:7:"enabled";b:1;s:7:"eyebrow";s:10:"Our coffee";s:5:"title";s:34:"Brewed exclusively with Hausbrandt";s:4:"text";s:319:"Great coffee starts with the bean. That is why every cup at Kaffekos is made with **Hausbrandt** coffee beans, and only Hausbrandt.

Roasting coffee in Trieste, Italy since 1892, Hausbrandt is known for premium Italian coffee and for choosing excellence. It is the same standard we hold ourselves to, one cup at a time.";s:5:"image";s:19:"hausbrandt-pack.png";s:6:"image2";s:22:"hausbrandt-sublime.png";s:7:"caption";s:44:"Hausbrandt Gourmet and Sublime, 100% Arabica";s:5:"facts";a:3:{i:0;a:2:{s:5:"value";s:10:"Hausbrandt";s:5:"label";s:15:"our only coffee";}i:1;a:2:{s:5:"value";s:7:"Trieste";s:5:"label";s:5:"Italy";}i:2;a:2:{s:5:"value";s:4:"1892";s:5:"label";s:14:"roasting since";}}s:10:"link_label";s:19:"Discover Hausbrandt";s:8:"link_url";s:29:"https://www.hausbrandt.it/en/";}s:10:"highlights";a:4:{s:7:"enabled";b:1;s:5:"title";s:21:"Made for slow moments";s:8:"subtitle";s:81:"Everything at Kaffekos is designed around one simple idea: make you feel at home.";s:5:"items";a:4:{i:0;a:3:{s:4:"icon";s:3:"cup";s:5:"title";s:24:"Carefully crafted coffee";s:4:"text";s:98:"Exclusively Hausbrandt beans, with rich aroma, smooth taste and refined presentation in every cup.";}i:1;a:3:{s:4:"icon";s:3:"bun";s:5:"title";s:21:"Nordic-inspired bites";s:4:"text";s:80:"Warm cinnamon buns, heart-shaped waffles and open sandwiches, the Norwegian way.";}i:2;a:3:{s:4:"icon";s:5:"heart";s:5:"title";s:18:"A cosy, calm space";s:4:"text";s:63:"Clean design, soft light and a relaxed Scandinavian café feel.";}i:3;a:3:{s:4:"icon";s:5:"users";s:5:"title";s:16:"Warm hospitality";s:4:"text";s:60:"Come as you are. Bring a book, a friend or the whole family.";}}}s:8:"featured";a:6:{s:7:"enabled";b:1;s:11:"show_prices";b:0;s:5:"title";s:14:"Our favourites";s:8:"subtitle";s:50:"A taste of what is brewing and baking at Kaffekos.";s:5:"limit";i:6;s:12:"button_label";s:17:"See the full menu";}s:5:"quote";a:4:{s:7:"enabled";b:1;s:4:"word";s:3:"kos";s:13:"pronunciation";s:28:"/kuːs/ · noun · Norwegian";s:4:"text";s:107:"The simple joy of a warm drink, good company and a moment slowed down. It is the heart of everything we do.";}s:10:"photostrip";a:4:{s:7:"enabled";b:1;s:5:"title";s:13:"A peek inside";s:8:"subtitle";s:23:"Moments from the café.";s:5:"count";i:6;}s:7:"reviews";a:3:{s:7:"enabled";b:0;s:5:"title";s:19:"What our guests say";s:8:"subtitle";s:0:"";}s:5:"visit";a:4:{s:7:"enabled";b:1;s:7:"eyebrow";s:9:"Velkommen";s:5:"title";s:20:"Come and sit with us";s:4:"text";s:53:"The kettle is on. Find us in Lahore and stay a while.";}s:8:"metadata";a:1:{s:11:"description";s:171:"Kaffekos is a Norwegian-inspired coffee house in Johar Town, Lahore. Coffee, Comfort, Connection: premium Hausbrandt coffee, warm bakes and a cosy Scandinavian atmosphere.";}}s:34:"8eda457babf5f058b9ec2937c1a8521asc";a:4:{s:5:"title";s:6:"Events";s:4:"menu";s:6:"Events";s:6:"banner";a:2:{s:7:"eyebrow";s:13:"Arrangementer";s:8:"subtitle";s:92:"Events, activities and little happenings at Kaffekos. Come for the coffee, stay for the kos.";}s:9:"published";b:1;}s:34:"72a0c946dc51f93caf3905b360350b33sc";a:9:{s:5:"title";s:28:"Our First Day: A Soft Launch";s:4:"date";s:16:"2026-09-11 00:00";s:11:"media_order";s:59:"soft-launch-cover.jpg, soft-launch-2.jpg, soft-launch-3.jpg";s:5:"cover";s:21:"soft-launch-cover.jpg";s:11:"cover_focus";s:5:"upper";s:4:"kind";s:5:"event";s:4:"when";s:24:"Friday 11 September 2026";s:5:"where";s:16:"Kaffekos, Lahore";s:7:"summary";s:100:"Today was our very first day: a relaxed soft launch with good coffee, board games and plenty of kos.";}s:34:"bd2a099c6d296562286165997f220aeasc";a:11:{s:5:"title";s:37:"Friday Night, Live with munis.mujahid";s:4:"date";s:16:"2026-10-09 15:00";s:14:"unpublish_date";s:16:"2026-10-10 00:00";s:11:"media_order";s:93:"friday-live-1.jpg, friday-live-2.jpg, friday-live-3.jpg, friday-live-4.jpg, friday-live-5.jpg";s:5:"cover";s:17:"friday-live-1.jpg";s:11:"cover_focus";s:4:"full";s:4:"kind";s:5:"event";s:4:"when";s:26:"Fri 9 Oct, 8:00 PM onwards";s:5:"where";s:43:"Grand Park, Shouq Chowk, Johar Town, Lahore";s:7:"summary";s:143:"Live music in the open air with munis.mujahid, board games on the table and 15% off all drinks and savoury items. Free entry, no ticket needed.";s:7:"gallery";a:4:{i:0;a:2:{s:5:"image";s:17:"friday-live-2.jpg";s:7:"caption";s:64:"Your Friday just got better: 15% off all drinks + savoury items.";}i:1;a:2:{s:5:"image";s:17:"friday-live-3.jpg";s:7:"caption";s:67:"What to expect at Kaffekos: a Friday night built around good vibes.";}i:2;a:2:{s:5:"image";s:17:"friday-live-4.jpg";s:7:"caption";s:51:"Play a little. Stay a little longer. Music + games.";}i:3;a:2:{s:5:"image";s:17:"friday-live-5.jpg";s:7:"caption";s:37:"Our location: Grand Park, Johar Town.";}}}s:34:"7db8389076fe0245ef446966cb1b29cbsc";a:9:{s:5:"title";s:29:"Dr. Omer Adil Visits Kaffekos";s:4:"date";s:10:"26-09-2026";s:11:"media_order";s:22:"dr-omer-adil-visit.jpg";s:5:"cover";s:22:"dr-omer-adil-visit.jpg";s:11:"cover_focus";s:6:"middle";s:4:"kind";s:5:"event";s:4:"when";s:26:"Saturday 26 September 2026";s:5:"where";s:16:"Kaffekos, Lahore";s:7:"summary";s:123:"We were honoured to welcome Dr. Omer Adil, the well-known orthopedic surgeon, professor and media personality, to Kaffekos.";}s:34:"112b5fd55a294eeac512996808a15322sc";a:4:{s:5:"title";s:11:"Drinks Menu";s:4:"menu";s:4:"Menu";s:6:"banner";a:2:{s:7:"eyebrow";s:4:"Meny";s:8:"subtitle";s:48:"Coffee, matcha, shakes and more, made with care.";}s:12:"menu_options";a:3:{s:11:"show_prices";b:0;s:11:"show_images";b:1;s:4:"note";s:50:"Please tell us about any allergies when you order.";}}s:34:"eed88470a30d0f6c4ef7e2c54c64c59csc";a:4:{s:5:"title";s:11:"Cold Drinks";s:9:"published";b:0;s:11:"description";s:51:"Chilled and refreshing, for warm Lahore afternoons.";s:5:"items";a:4:{i:0;a:5:{s:4:"name";s:10:"Iced Latte";s:5:"price";s:3:"650";s:11:"description";s:32:"Espresso and cold milk over ice.";s:5:"image";s:14:"iced-latte.jpg";s:8:"featured";b:1;}i:1;a:4:{s:4:"name";s:9:"Cold Brew";s:5:"price";s:3:"700";s:11:"description";s:49:"Steeped slowly for a smooth, naturally sweet cup.";s:5:"badge";s:3:"New";}i:2;a:3:{s: