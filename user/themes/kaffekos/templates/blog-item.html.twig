{% extends 'partials/base.html.twig' %}
{% import 'macros/kk.html.twig' as kk %}
{% set cover = header.cover ? page.media[header.cover] : null %}
{% block og_image %}{% if cover %}<meta property="og:image" content="{{ url(kk.imgurl(cover, 1200, 630), true) }}">{% else %}{{ parent() }}{% endif %}{% endblock %}
{% block hero %}
<section class="page-banner post-banner">
    <div class="wrap wrap-narrow">
        <p class="eyebrow"><a href="{{ page.parent.url }}">{{ page.parent.title }}</a> &middot; {{ page.date|date('j F Y') }}</p>
        <h1>{{ page.title }}</h1>
    </div>
    <div class="pattern-band pattern-band-gold" aria-hidden="true"></div>
</section>
{% endblock %}
{% block content %}
<article class="section">
    <div class="wrap wrap-narrow">
        {% if cover %}<div class="post-hero">{{ kk.img(cover, 1100, 620, page.title, null, false) }}</div>{% endif %}
        <div class="prose">{{ page.content|raw }}</div>
        <p class="center"><a class="btn btn-outline" href="{{ page.parent.url }}">&larr; All news</a></p>
    </div>
</article>
{% endblock %}
