{% extends 'partials/base.html.twig' %}
{% block body_class %}page-menu{% endblock %}
{% block hero %}
<section class="menu-hero">
    <div class="wrap">
        {% if header.banner.eyebrow %}<p class="eyebrow">{{ header.banner.eyebrow }}</p>{% endif %}
        <h1>{{ page.title }}</h1>
        {% if header.banner.subtitle %}<p class="lead">{{ header.banner.subtitle }}</p>{% endif %}
        <label class="menu-search">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            <input type="search" id="menu-search" placeholder="{{ 'KK.MENU.SEARCH_PH'|t }}" autocomplete="off" aria-label="{{ 'KK.MENU.SEARCH'|t }}">
        </label>
        <div class="menu-controls" id="menu-controls" role="group" aria-label="{{ 'KK.MENU.FILTERS'|t }}"></div>
    </div>
    <div class="pattern-band pattern-band-gold" aria-hidden="true"></div>
</section>
{% endblock %}
{% block content %}
{% set cats = page.children.published %}
{% set show_images = header.menu_options.show_images is null or header.menu_options.show_images %}
{% set show_prices = header.menu_options.show_prices is null or header.menu_options.show_prices %}
<section class="section menu-poster">
    {% if page.content|striptags|trim %}
        <div class="wrap wrap-narrow prose center">{{ page.content|raw }}</div>
    {% endif %}

    {# group the categories by their "Menu section" (Drinks, Sandwiches, ...) in page order #}
    {% set groups = {} %}
    {% for cat in cats %}
        {% set g = cat.header.group ?: 'KK.MENU.DEFAULT_GROUP'|t %}
        {% set groups = groups|merge({(g): (groups[g] ?? [])|merge([cat])}) %}
    {% endfor %}

    {% if cats|length > 1 %}
        <nav class="menu-tabs" aria-label="{{ 'KK.MENU.CATEGORIES'|t }}">
            <div class="wrap">
                {% for g, list in groups %}{% for cat in list %}<a href="#{{ cat.slug }}" class="tab-{{ cat.header.tone ?: 'blue' }}" data-group="{{ g|lower|replace({' ': '-'}) }}">{{ cat.title }}</a>{% endfor %}{% endfor %}
            </div>
        </nav>
    {% endif %}

    <div class="wrap wrap-menu-poster">
        {% for g, list in groups %}
            {% set gslug = g|lower|replace({' ': '-'}) %}
            <div class="menu-group" data-group="{{ gslug }}" data-group-label="{{ g }}">
                {% if groups|length > 1 %}<h2 class="menu-group-title"><span>{{ 'KK.MENU.GROUP_TITLE'|t(g) }}</span></h2>{% endif %}
                <div class="menu-blocks">
                    {% for cat in list %}
                        {% include 'partials/menu-section.html.twig' with {cat: cat, currency: theme_var('menu.currency'), show_images: show_images, show_prices: show_prices} %}
                    {% endfor %}
                    {% if list|length is odd and list|length > 1 %}
                        <aside class="menu-block menu-filler" aria-hidden="true">
                            <img src="{{ url('theme://images/menu/chef.png') }}" alt="" loading="lazy">
                            <p>{{ 'KK.MENU.FILLER'|t }}</p>
                        </aside>
                    {% endif %}
                </div>
            </div>
        {% else %}
            <p class="center">{{ 'KK.MENU.PREPARING'|t }}</p>
        {% endfor %}
        <p class="menu-empty" id="menu-empty" hidden>{{ 'KK.MENU.NO_MATCH'|t }}</p>

        <div class="menu-closing">
            <img src="{{ url('theme://images/menu/norway.png') }}" alt="" loading="lazy">
            <div>
                <p class="menu-closing-title">{{ 'KK.MENU.MADE_WITH'|t }}</p>
                {% if header.menu_options.note %}<p>{{ header.menu_options.note }}</p>{% endif %}
            </div>
        </div>
    </div>
</section>
{% endblock %}
