{% extends 'partials/base.html.twig' %}
{% block body_class %}page-menu{% endblock %}
{% block hero %}
<section class="menu-hero">
    <div class="menu-stickers" aria-hidden="true">
        <span class="menu-sticker" style="--x:4%;--y:18%;--r:-8deg;--d:0s;--t:5.2s">☕</span>
        <span class="menu-sticker" style="--x:88%;--y:14%;--r:7deg;--d:.6s;--t:6s">🥪</span>
        <span class="menu-sticker" style="--x:10%;--y:52%;--r:-5deg;--d:1.1s;--t:5.6s">🍪</span>
        <span class="menu-sticker" style="--x:86%;--y:50%;--r:9deg;--d:.3s;--t:6.4s">🍩</span>
        <span class="menu-sticker" style="--x:3%;--y:82%;--r:6deg;--d:1.6s;--t:5.8s">🧁</span>
        <span class="menu-sticker" style="--x:92%;--y:84%;--r:-7deg;--d:.9s;--t:5.4s">🍔</span>
        <span class="menu-sticker" style="--x:20%;--y:8%;--r:5deg;--d:2s;--t:6.2s">🥤</span>
        <span class="menu-sticker" style="--x:76%;--y:7%;--r:-6deg;--d:1.3s;--t:5.9s">🍵</span>
    </div>
    <div class="wrap">
        {% if header.banner.eyebrow %}<p class="eyebrow">{{ header.banner.eyebrow }}</p>{% endif %}
        <h1>{{ page.title }}</h1>
        {% if header.banner.subtitle %}<p class="lead">{{ header.banner.subtitle }}</p>{% endif %}
        <label class="menu-search" id="menu-search-box" data-hints="{{ 'KK.MENU.SEARCH_HINTS'|t }}" data-prefix="{{ 'KK.MENU.SEARCH_PREFIX'|t }}" data-found="{{ 'KK.MENU.FOUND'|t }}" data-none="{{ 'KK.MENU.FOUND_NONE'|t }}">
            <span class="ms-ico" aria-hidden="true">🔍</span>
            <input type="search" id="menu-search" placeholder="{{ 'KK.MENU.SEARCH_PH'|t }}" autocomplete="off" aria-label="{{ 'KK.MENU.SEARCH'|t }}">
            <span class="ms-count" id="menu-search-count" aria-live="polite" hidden></span>
            <button type="button" class="ms-clear" id="menu-search-clear" aria-label="{{ 'KK.MENU.CLEAR'|t }}" hidden>✕</button>
        </label>
        <div class="menu-controls" id="menu-controls">
            <div class="mc-zone mc-cats" hidden>
                <p class="mc-label">{{ 'KK.MENU.CRAVING'|t }}</p>
                <div class="mc-row" id="menu-cats" role="group" aria-label="{{ 'KK.MENU.FILTERS'|t }}"></div>
            </div>
            <div class="mc-zone mc-tools">
                <p class="mc-label">{{ 'KK.MENU.TOOLS'|t }}</p>
                <div class="mc-row" id="menu-tools" data-picks-sub="{{ 'KK.MENU.PICKS_SUB'|t }}" data-surprise-sub="{{ 'KK.MENU.SURPRISE_SUB'|t }}"></div>
            </div>
        </div>
        {% set pdf = page.media[header.menu_options.pdf ?: 'kaffekos-menu.pdf'] %}
        {% if pdf %}
            <a class="menu-dl" href="{{ pdf.url }}" download target="_blank" rel="noopener">
                <span class="menu-dl-icon"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0-5-5m5 5 5-5M5 20h14"/></svg></span>
                <span class="menu-dl-text"><strong>{{ 'KK.MENU.DOWNLOAD'|t }}</strong><small>{{ 'KK.MENU.DOWNLOAD_SUB'|t }}</small></span>
            </a>
        {% endif %}
    </div>
    <div class="pattern-band pattern-band-gold" aria-hidden="true"></div>
</section>
{% set pdf = page.media[header.menu_options.pdf ?: 'kaffekos-menu.pdf'] %}
{% if pdf %}
<a class="menu-dl-fab" id="menu-dl-fab" href="{{ pdf.url }}" download target="_blank" rel="noopener" aria-label="{{ 'KK.MENU.DOWNLOAD'|t }}">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0-5-5m5 5 5-5M5 20h14"/></svg> <span>{{ 'KK.MENU.DOWNLOAD'|t }}</span>
</a>
{% endif %}
{% endblock %}
{% block content %}
{% set cats = page.children.published %}
{% set show_images = header.menu_options.show_images is null or header.menu_options.show_images %}
{% set show_prices = header.menu_options.show_prices is null or header.menu_options.show_prices %}
<section class="section menu-poster">
    {% if page.content|striptags|trim %}
        <div class="wrap wrap-narrow prose center">{{ page.content|raw }}</div>
    {% endif %}

    {# group the categories by their "Menu section" (Drinks, Sandwiches, ...) in page order #}
    {% set groups = {} %}
    {% for cat in cats %}
        {% set g = cat.header.group ?: 'KK.MENU.DEFAULT_GROUP'|t %}
        {% set groups = groups|merge({(g): (groups[g] ?? [])|merge([cat])}) %}
    {% endfor %}

    {% if cats|length > 1 %}
        <nav class="menu-tabs" aria-label="{{ 'KK.MENU.CATEGORIES'|t }}">
            <div class="wrap">
                {% for g, list in groups %}{% for cat in list %}<a href="#{{ cat.slug }}" class="tab-{{ cat.header.tone ?: 'blue' }}" data-group="{{ g|lower|replace({' ': '-'}) }}">{{ cat.title }}</a>{% endfor %}{% endfor %}
            </div>
        </nav>
    {% endif %}

    <div class="wrap wrap-menu-poster">
        {% for g, list in groups %}
            {% set gslug = g|lower|replace({' ': '-'}) %}
            <div class="menu-group" data-group="{{ gslug }}" data-group-label="{{ g }}">
                {% if groups|length > 1 %}<h2 class="menu-group-title"><span>{{ 'KK.MENU.GROUP_TITLE'|t(g) }}</span></h2>{% endif %}
                <div class="menu-blocks">
                    {% for cat in list %}
                        {% include 'partials/menu-section.html.twig' with {cat: cat, currency: theme_var('menu.currency'), show_images: show_images, show_prices: show_prices} %}
                    {% endfor %}
                    {% if list|length is odd and list|length > 1 %}
                        <aside class="menu-block menu-filler" aria-hidden="true">
                            <img src="{{ url('theme://images/menu/chef.png') }}" alt="" loading="lazy">
                            <p>{{ 'KK.MENU.FILLER'|t }}</p>
                        </aside>
                    {% endif %}
                </div>
            </div>
        {% else %}
            <p class="center">{{ 'KK.MENU.PREPARING'|t }}</p>
        {% endfor %}
        <p class="menu-empty" id="menu-empty" hidden>{{ 'KK.MENU.NO_MATCH'|t }}</p>

        <div class="menu-closing">
            <img src="{{ url('theme://images/menu/norway.png') }}" alt="" loading="lazy">
            <div>
                <p class="menu-closing-title">{{ 'KK.MENU.MADE_WITH'|t }}</p>
                {% if header.menu_options.note %}<p>{{ header.menu_options.note }}</p>{% endif %}
            </div>
        </div>
    </div>
</section>
{% set pdf = page.media[header.menu_options.pdf ?: 'kaffekos-menu.pdf'] %}
{% if pdf %}
<a class="menu-dl-fab" id="menu-dl-fab" href="{{ pdf.url }}" download target="_blank" rel="noopener" aria-label="{{ 'KK.MENU.DOWNLOAD'|t }}">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0-5-5m5 5 5-5M5 20h14"/></svg> <span>{{ 'KK.MENU.DOWNLOAD'|t }}</span>
</a>
{% endif %}
{% endblock %}
