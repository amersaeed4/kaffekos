    'wifi': '<path d="M2 9a15 15 0 0 1 20 0"/><path d="M5 12.500a10.500 10.500 0 0 1 14 0"/><path d="M8.500 16a6 6 0 0 1 7 0"/><path d="M12 19.500h.01"/>',
