    'book': '<path d="M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2z"/><path d="M4 5v16"/><path d="M8.500 7h6"/>',
    'music': '<path d="M9 18V5l11-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="17" cy="16" r="3"/>',
    'star': '<path d="M12 3l2.800 5.700 6.200.9-4.500 4.400 1.100 6.200L12 17.200l-5.600 3 1.100-6.200L3 9.600l6.200-.9z"/>',
