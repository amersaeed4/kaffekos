{# A cosy Scandinavian character (faces right, seated on a stool, holding a mug) for the Home "kos" scene.
   c: sweater, hat, band, hair, skin, mug, pants, begin (SMIL delay), beard (bool), braids (bool) #}
{% macro kos_person(c) %}
<g class="nw-person">
    <rect x="40" y="176" width="92" height="12" rx="6" fill="#9a6a47"/>
    <path d="M56 188L48 240M116 188L124 240" stroke="#7a4f36" stroke-width="7" stroke-linecap="round"/>
    <rect x="62" y="154" width="98" height="26" rx="13" fill="{{ c.pants }}"/>
    <rect x="140" y="166" width="24" height="64" rx="11" fill="{{ c.pants }}"/>
    <path d="M138 224H178a9 9 0 0 1 0 16H138Z" fill="#4a2f22"/>
    <path d="M52 82Q50 66 72 64H108Q132 66 130 86L134 160H54Z" fill="{{ c.sweater }}"/>
    <rect x="53" y="106" width="78" height="16" fill="#f6efe3"/>
    {% for k in 0..4 %}<path d="M{{ 66 + k * 15 }} 114l6-5 6 5-6 5Z" fill="{{ c.sweater }}"/>{% endfor %}
    <rect x="54" y="152" width="80" height="8" rx="3" fill="#f6efe3" opacity=".35"/>
    {% if c.braids %}<path d="M68 52Q56 72 62 98" stroke="{{ c.hair }}" stroke-width="11" stroke-linecap="round" fill="none"/><circle cx="62" cy="99" r="4.5" fill="{{ c.mug }}"/>{% endif %}
    <rect x="80" y="58" width="18" height="14" fill="{{ c.skin }}"/>
    <circle cx="90" cy="44" r="26" fill="{{ c.skin }}"/>
    <circle cx="68" cy="48" r="5" fill="{{ c.skin }}"/>
    {% if c.beard %}<path d="M66 50C64 84 116 86 116 52C106 64 78 64 66 50Z" fill="{{ c.hair }}"/>{% endif %}
    <path d="M99 48q5 5 10 0" stroke="#3a2418" stroke-width="2.4" fill="none" stroke-linecap="round"/>
    <circle cx="105" cy="57" r="4.5" fill="#f08a7e" opacity=".55"/>
    <path d="M98 60q7 7 14 0" stroke="{{ c.beard ? '#f6efe3' : '#3a2418' }}" stroke-width="2.2" fill="none" stroke-linecap="round"/>
    <path d="M62 38C58 4 122 2 118 38Z" fill="{{ c.hat }}"/>
    <rect x="60" y="32" width="60" height="13" rx="6" fill="{{ c.band }}"/>
    {% for k in 0..4 %}<circle cx="{{ 70 + k * 10 }}" cy="38.5" r="2.2" fill="{{ c.hat }}"/>{% endfor %}
    <circle cx="90" cy="6" r="9" fill="#fff"/>
    <g>
        <animateTransform attributeName="transform" type="rotate" values="0 110 86;-7 110 86;0 110 86" dur="4.6s" begin="{{ c.begin }}" repeatCount="indefinite"/>
        <path d="M108 86Q134 104 148 126" stroke="{{ c.sweater }}" stroke-width="22" stroke-linecap="round" fill="none"/>
        <rect x="146" y="108" width="28" height="32" rx="6" fill="#f6efe3"/>
        <rect x="146" y="118" width="28" height="7" fill="{{ c.mug }}"/>
        <path d="M174 114a9 9 0 0 1 0 18" stroke="#f6efe3" stroke-width="5" fill="none"/>
        <circle cx="148" cy="130" r="9" fill="{{ c.skin }}"/>
        <path class="nw-steam" d="M156 102q-6-9 0-16t0-14" stroke="#fff" stroke-width="3" fill="none" stroke-linecap="round"/>
        <path class="nw-steam nw-steam-2" d="M166 102q-6-9 0-16t0-14" stroke="#fff" stroke-width="3" fill="none" stroke-linecap="round"/>
    </g>
</g>
{% endmacro %}

