<svg class="icon icon-{{ name }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">{{ paths[name]|default(paths['star'])|raw }}</svg>
{%- endmacro %}

{# Resized <img>. `medium` is a Grav media object (page.media['file.jpg']); returns nothing if missing. #}
{% macro img(medium, w, h, alt, cls, lazy) %}
{%- if medium -%}
    {%- set m1 = medium.cropZoom(w, h).quality(80) -%}
    {%- set m2 = medium.cropZoom(w * 2, h * 2).quality(76) -%}
    <img src="{{ m1.url }}" srcset="{{ m1.url }} 1x, {{ m2.url }} 2x" width="{{ w }}" height="{{ h }}" alt="{{ alt|e('html_attr') }}"{% if cls %} class="{{ cls }}"{% endif %}{% if lazy is not same as(false) %} loading="lazy" decoding="async"{% endif %}>
{%- endif -%}
{% endmacro %}

{# Resized <img> that keeps the photo's own proportions (fits inside w x h). Used by the masonry gallery. #}
{% macro imgfit(medium, w, h, alt, cls) %}
{%- if medium -%}
    {%- set m1 = medium.cropResize(w, h).quality(80) -%}
    <img src="{{ m1.url }}" width="{{ m1.width }}" height="{{ m1.height }}" alt="{{ alt|e('html_attr') }}"{% if cls %} class="{{ cls }}"{% endif %} loading="lazy" decoding="async">
{%- endif -%}
{% endmacro %}

{# Plain URL of a resized picture (for CSS backgrounds / meta tags) #}
{% macro imgurl(medium, w, h) %}
{%- if medium -%}{{ medium.cropZoom(w, h).quality(80).url }}{%- endif -%}
{% endmacro %}

{# Same, but fitted inside w x h WITHOUT cropping, so CSS decides what part stays visible (hero / banners) #}
{% macro imgurlfit(medium, w, h) %}
{%- if medium -%}{{ medium.cropResize(w, h).quality(80).url }}{%- endif -%}
{% endmacro %}

{# Link that works for /internal, relative, http(s), mailto, tel and #anchor addresses #}
{% macro href(u) %}
{%- if u starts with 'http' or u starts with 'mailto:' or u starts with 'tel:' or u starts with '#' -%}{{ u }}{%- else -%}{{ url(u) }}{%- endif -%}
{% endmacro %}

{# Menu price: adds the currency in front of a plain number, leaves text like "Small 450 / Large 600" alone #}
{% macro price(p, currency) %}
{%- set t = p|trim -%}
{%- if t matches '/^[0-9][0-9.,]*$/' -%}{{ currency }}&nbsp;{{ t }}{%- else -%}{{ t }}{%- endif -%}
{% endmacro %}

{# 24h "HH:MM" -> "8:00 AM" #}
{% macro time12(t) %}
{%- if t -%}{{ ('2000-01-01 ' ~ t)|date('g:i A') }}{%- endif -%}
{% endmacro %}
