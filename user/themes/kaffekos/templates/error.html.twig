{% extends 'partials/base.html.twig' %}
{% block body_class %}is-error{% endblock %}
{% block content %}
<section class="section error-page">
    <div class="wrap wrap-narrow center">
        <p class="kos-word">{{ page.header.http_response_code ?: 404 }}</p>
        <h1>Oi! This page has wandered off.</h1>
        <p class="lead">The page you are looking for does not exist, but there is always a fresh cup waiting on our menu.</p>
        <p class="hero-actions" style="justify-content:center">
            <a class="btn btn-primary" href="{{ base_url == '' ? '/' : base_url }}">Back to the home page</a>
            <a class="btn btn-outline" href="{{ url('/menu') }}">See the menu</a>
        </p>
    </div>
</section>
{% endblock %}
