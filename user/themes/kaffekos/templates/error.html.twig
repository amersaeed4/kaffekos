{% extends 'partials/base.html.twig' %}
{% block body_class %}is-error{% endblock %}
{% block content %}
<section class="section error-page">
    <div class="wrap wrap-narrow center">
        <p class="kos-word">{{ page.header.http_response_code ?: 404 }}</p>
        <h1>{{ 'KK.ERROR.TITLE'|t }}</h1>
        <p class="lead">{{ 'KK.ERROR.TEXT'|t }}</p>
        <p class="hero-actions" style="justify-content:center">
            <a class="btn btn-primary" href="{{ base_url == '' ? '/' : base_url }}">{{ 'KK.ERROR.HOME'|t }}</a>
            <a class="btn btn-outline" href="{{ url('/menu') }}">{{ 'KK.ERROR.MENU'|t }}</a>
        </p>
    </div>
</section>
{% endblock %}
