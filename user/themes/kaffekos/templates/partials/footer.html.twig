{% import 'macros/kk.html.twig' as kk %}
{% set biz = theme_var('business') %}
{% set social = theme_var('social') %}
{% set hours = theme_var('hours') %}
{% set tagline = kk_l('brand.tagline') %}
<footer class="site-footer">
    <div class="pattern-band" aria-hidden="true"></div>
    <div class="wrap footer-grid">
        <div class="footer-brand">
            <a class="brand brand-light" href="{{ base_url == '' ? '/' : base_url }}">
                <img src="{{ logo_url }}" alt="" width="52" height="52">
                <span class="brand-text">
                    <span class="brand-name">{{ theme_var('brand.wordmark') ?: site.title }}</span>
                    {% if tagline %}<span class="brand-tag">{{ tagline }}</span>{% endif %}
                </span>
            </a>
            <p>{{ kk_l('footer.about') }}</p>
            <ul class="social">
                {% set social_names = {instagram: 'Instagram', facebook: 'Facebook', tiktok: 'TikTok', youtube: 'YouTube', linkedin: 'LinkedIn', x: 'X'} %}
                {% for key in ['instagram', 'facebook', 'tiktok', 'youtube', 'linkedin', 'x'] %}
                    {% if social[key] %}
                        <li><a href="{{ social[key] }}" target="_blank" rel="noopener" aria-label="{{ social_names[key] }}">{{ kk.icon(key, 20) }}</a></li>
                    {% elseif key != 'x' %}
                        <li><span class="is-soon" title="{{ 'KK.SOON'|t(social_names[key]) }}" role="img" aria-label="{{ 'KK.SOON'|t(social_names[key]) }}">{{ kk.icon(key, 20) }}</span></li>
                    {% endif %}
                {% endfor %}
                {% if biz.whatsapp %}
                    <li><a href="https://wa.me/{{ biz.whatsapp }}" target="_blank" rel="noopener" aria-label="WhatsApp">{{ kk.icon('whatsapp', 20) }}</a></li>
                {% endif %}
            </ul>
        </div>

        <div>
            <h3 class="footer-title">{{ 'KK.FOOTER.EXPLORE'|t }}</h3>
            <ul class="footer-links">
                {% for p in pages.children.visible %}
                    <li><a href="{{ p.url }}">{{ p.menu }}</a></li>
                {% endfor %}
            </ul>
        </div>

        <div>
            <h3 class="footer-title">{{ 'KK.FIND_US'|t }}</h3>
            <address class="footer-address">
                {{ biz.address|e('html')|nl2br }}
            </address>
            <ul class="footer-links">
                {% if biz.phone %}<li><a href="tel:{{ biz.phone|replace({' ': ''}) }}">{{ kk.icon('phone', 16) }} {{ biz.phone }}</a></li>{% endif %}
                {% if biz.email %}<li><a href="mailto:{{ biz.email }}">{{ kk.icon('mail', 16) }} {{ biz.email }}</a></li>{% endif %}
                {% if biz.maps_url %}<li><a href="{{ biz.maps_url }}" target="_blank" rel="noopener">{{ kk.icon('pin', 16) }} {{ 'KK.GET_DIRECTIONS'|t }}</a></li>{% endif %}
            </ul>
        </div>

        <div>
            <h3 class="footer-title">{{ 'KK.OPENING_HOURS'|t }}</h3>
            {% include 'partials/hours.html.twig' with {compact: true} %}
        </div>
    </div>
    <div class="footer-bottom">
        <div class="wrap">
            <span>&copy; {{ 'now'|date('Y') }} {{ kk_l('footer.copyright') }}</span>
            {% if kk_l('footer.tagline') %}<span class="footer-kos">{{ kk_l('footer.tagline') }}</span>{% endif %}
        </div>
    </div>
</footer>
