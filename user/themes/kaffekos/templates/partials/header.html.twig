{% import 'macros/kk.html.twig' as kk %}
{% set cta_label = kk_l('header.cta_label') %}
{% set tagline = kk_l('brand.tagline') %}
{% set switch_urls = kk_lang_urls() %}
{% set cur_lang = kk_lang() %}
{% set cta_url = theme_var('header.cta_url') %}
{% set wordmark = theme_var('brand.wordmark') ?: site.title %}
<header class="site-header" id="site-header">
    <div class="wrap header-inner">
        <a class="brand" href="{{ base_url == '' ? '/' : base_url }}" aria-label="{{ 'KK.HOME_ARIA'|t(site.title) }}">
            <img src="{{ logo_url }}" alt="" width="44" height="44">
            <span class="brand-text">
                <span class="brand-name">{{ wordmark }}</span>
                {% if tagline %}<span class="brand-tag">{{ tagline }}</span>{% endif %}
            </span>
        </a>

        {# phones: the switcher sits in the header bar itself, so it is visible without opening the menu #}
        {% include 'partials/lang-switch.html.twig' with {variant: 'bar'} %}

        <nav class="main-nav" id="main-nav" aria-label="{{ 'KK.MAIN_NAV'|t }}">
            <ul>
                {% for p in pages.children.visible %}
                    <li><a href="{{ p.url }}" class="{{ p.active or p.activeChild ? 'active' : '' }}">{{ p.menu }}</a></li>
                {% endfor %}
            </ul>
            {% if cta_label %}
                <a class="btn btn-primary nav-cta" href="{{ kk.href(cta_url) }}">{{ cta_label }}</a>
            {% endif %}
            {% include 'partials/lang-switch.html.twig' %}
        </nav>

        <button class="nav-toggle" type="button" aria-controls="main-nav" aria-expanded="false" aria-label="{{ 'KK.JS.MENU_OPEN'|t }}">
            <span></span><span></span><span></span>
        </button>
    </div>
</header>
