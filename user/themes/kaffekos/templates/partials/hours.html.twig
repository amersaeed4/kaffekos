{% import 'macros/kk.html.twig' as kk %}
{# Opening hours table. Pass compact: true for the footer version #}
<table class="hours{{ compact ? ' hours-compact' : '' }}" data-hours-table>
    <tbody>
    {% for h in theme_var('hours') %}
        <tr data-day="{{ h.day|lower }}">
            {% set day_name = ('KK.DAYS.' ~ h.day|upper)|t %}
            <th scope="row">{{ compact ? day_name|slice(0, 3) : day_name }}</th>
            <td>{% if h.closed %}{{ 'KK.CLOSED'|t }}{% else %}{{ kk.time12(h.open) }} &ndash; {{ kk.time12(h.close) }}{% endif %}</td>
        </tr>
    {% endfor %}
    </tbody>
</table>
{% if kk_l('hours_note') %}<p class="hours-note">{{ kk_l('hours_note') }}</p>{% endif %}
