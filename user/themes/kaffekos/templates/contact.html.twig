{% extends 'partials/base.html.twig' %}
{% import 'macros/kk.html.twig' as kk %}
{% block body_class %}page-contact{% endblock %}
{% set gloss = 'KK.GLOSS'|t == 'show' %}

{% block hero %}
{% set bimg = header.banner.image ? page.media[header.banner.image] : null %}
{% set biz = theme_var('business') %}
<section class="ct-hero{{ bimg ? ' has-photo' : '' }}"{% if bimg %} style="--banner: url('{{ kk.imgurlfit(bimg, 2000, 2000) }}')"{% endif %}>
    <span class="ct-chip ct-chip-1" aria-hidden="true"><b>Hei!</b>{% if gloss %} hello{% endif %}</span>
    <span class="ct-chip ct-chip-2" aria-hidden="true"><b>Kaffe?</b>{% if gloss %} coffee?{% endif %}</span>
    <span class="ct-chip ct-chip-3" aria-hidden="true"><b>Takk</b>{% if gloss %} thanks{% endif %}</span>
    <div class="ct-badge" aria-hidden="true">
        <svg class="ring" viewBox="0 0 120 120">
            <defs><path id="ct-circ" d="M60,60 m-47,0 a47,47 0 1,1 94,0 a47,47 0 1,1 -94,0"/></defs>
            <text><textPath href="#ct-circ" textLength="290" lengthAdjust="spacing">HEI · KAFFE · KOS · HEI · KAFFE · KOS · </textPath></text>
        </svg>
        {{ kk.icon('cup', 34) }}
    </div>
    <span class="ct-bean ct-bean-2" aria-hidden="true">{{ kk.icon('cup', 56) }}</span>
    <div class="wrap">
        {% if header.banner.eyebrow %}<p class="eyebrow">{{ header.banner.eyebrow }}</p>{% endif %}
        <h1>{% set words = page.title|split(' ') %}{% if words|length > 1 %}{{ words|slice(0, -1)|join(' ') }} {% endif %}<em>{{ words|last }}</em></h1>
        {% if header.banner.subtitle %}<p class="lead">{{ header.banner.subtitle }}</p>{% endif %}
        <p class="open-badge" data-open-status><span class="dot"></span><span data-open-text>{{ 'KK.CONTACT.HOURS_BELOW'|t }}</span></p>
    </div>
</section>

{# quick-contact tiles overlapping the bottom of the hero #}
<div class="wrap ct-quick-wrap">
    <ul class="ct-quick">
        {% if biz.phone %}
            <li><a class="ct-tile ct-tile-red" href="tel:{{ biz.phone|replace({' ': ''}) }}">
                <span class="ct-tile-icon">{{ kk.icon('phone', 26) }}</span>
                <small>{{ 'KK.CONTACT.CALL'|t }}</small><strong>{{ biz.phone }}</strong>
            </a></li>
        {% endif %}
        {% if biz.whatsapp %}
            <li><a class="ct-tile ct-tile-green" href="https://wa.me/{{ biz.whatsapp }}" target="_blank" rel="noopener">
                <span class="ct-tile-icon">{{ kk.icon('whatsapp', 26) }}</span>
                <small>WhatsApp</small><strong>{{ 'KK.CONTACT.CHAT'|t }}</strong>
            </a></li>
        {% endif %}
        {% if biz.email %}
            <li><a class="ct-tile ct-tile-gold" href="mailto:{{ biz.email }}">
                <span class="ct-tile-icon">{{ kk.icon('mail', 26) }}</span>
                <small>{{ 'KK.CONTACT.EMAIL'|t }}</small><strong>{{ biz.email }}</strong>
            </a></li>
        {% endif %}
        {% if biz.maps_url %}
            <li><a class="ct-tile ct-tile-navy" href="{{ biz.maps_url }}" target="_blank" rel="noopener">
                <span class="ct-tile-icon">{{ kk.icon('pin', 26) }}</span>
                <small>{{ 'KK.CONTACT.VISIT'|t }}</small><strong>{{ 'KK.GET_DIRECTIONS'|t }}</strong>
            </a></li>
        {% endif %}
    </ul>
</div>
{% endblock %}

{% block content %}
{% set biz = theme_var('business') %}
{% set social = theme_var('social') %}
{% set c = header.contact ?? {} %}
{% set topics = header.form.fields.subject.options ?? {} %}
<section class="section ct-main">
    {% if page.content|striptags|trim %}
        <div class="wrap wrap-narrow prose center">{{ page.content|raw }}</div>
    {% endif %}
    <div class="wrap contact-grid">
        <div class="contact-form card ct-form-card">
            <span class="ct-stamp" aria-hidden="true">{{ kk.icon('mail', 30) }}</span>
            <h2>{{ c.form_title ?: 'KK.CONTACT.FORM_TITLE'|t }}</h2>
            {% if c.form_intro %}<p class="ct-intro">{{ c.form_intro }}</p>{% endif %}
            {% if topics|length > 1 %}
                <div class="ct-topics" data-topics hidden>
                    <p class="ct-topics-label">{{ 'KK.CONTACT.TOPIC'|t }}</p>
                    <div class="ct-topics-list">
                        {% for value, label in topics %}
                            <button type="button" class="ct-topic" data-topic="{{ value|e('html_attr') }}">{{ label }}</button>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
            {% include 'forms/form.html.twig' %}
        </div>
        <aside class="contact-side">
            <div class="card ct-hours">
                <h2>{{ kk.icon('clock', 26) }} {{ 'KK.OPENING_HOURS'|t }}</h2>
                {% include 'partials/hours.html.twig' with {compact: false} %}
                <p class="open-badge" data-open-status><span class="dot"></span><span data-open-text></span></p>
            </div>
            <div class="card ct-hello">
                <span class="ct-hello-star" aria-hidden="true">{{ kk.icon('star', 28) }}</span>
                <h2>{{ kk.icon('heart', 26) }} {{ 'KK.CONTACT.SAY_HEJ'|t }}</h2>
                <p>{{ 'KK.CONTACT.POP_IN'|t }}</p>
                {% set links = {instagram: 'Instagram', facebook: 'Facebook', tiktok: 'TikTok', youtube: 'YouTube', linkedin: 'LinkedIn', x: 'X'} %}
                <ul class="ct-social">
                    {% for key, name in links %}
                        {% if social[key] %}
                            <li><a href="{{ social[key] }}" target="_blank" rel="noopener" aria-label="{{ name }}">{{ kk.icon(key, 20) }}<span>{{ name }}</span></a></li>
                        {% endif %}
                    {% endfor %}
                </ul>
            </div>
            {% set g = kk_google_rating() %}
            {% set review_url = kk_google_review_url() %}
            {% if g or review_url %}
                <div class="card ct-review">
                    {% if g %}
                        <a class="ct-review-rating" href="{{ biz.maps_url ?: '#' }}" target="_blank" rel="noopener" aria-label="{{ 'KK.HOME.GOOGLE_SEE'|t }}">
                            <span class="ct-review-g">{{ kk.google_g(30) }}</span>
                            <span class="ct-review-score">{{ g.rating|number_format(1) }}</span>
                            <span class="ct-review-meta">
                                <span class="ct-review-stars" style="--pct: {{ (g.rating / 5 * 100)|round }}%" role="img" aria-label="{{ 'KK.HOME.GOOGLE_STARS_ARIA'|t(g.rating|number_format(1)) }}">★★★★★</span>
                                <span class="ct-review-count">{{ (g.count == 1 ? 'KK.HOME.GOOGLE_REVIEWS_ONE' : 'KK.HOME.GOOGLE_REVIEWS')|t(g.count) }}</span>
                            </span>
                            <span class="ct-review-see">{{ kk.icon('arrow', 22) }}</span>
                        </a>
                    {% endif %}
                    {% if review_url %}
                        {% do assets.addJs('theme://js/qrcode.js', {group: 'bottom', loading: 'defer'}) %}
                        <div class="ct-review-ask">
                            <div class="ct-qr" data-qr="{{ review_url }}" role="img" aria-label="{{ 'KK.HOME.REVIEW_ALT'|t }}"></div>
                            <div class="ct-review-body">
                                <h2>{{ 'KK.HOME.REVIEW_TITLE'|t }}</h2>
                                <p class="ct-review-scan">{{ 'KK.HOME.REVIEW_SCAN'|t }}</p>
                                <p class="ct-review-tap">{{ 'KK.HOME.REVIEW_TAP'|t }}</p>
                                <a class="ct-review-btn" href="{{ review_url }}" target="_blank" rel="noopener"><span aria-hidden="true">★</span> {{ 'KK.HOME.REVIEW_BTN'|t }}</a>
                            </div>
                        </div>
                    {% endif %}
                </div>
            {% endif %}
        </aside>
    </div>

    {% if (c.show_map is null or c.show_map) and biz.lat and biz.lng %}
        {% set addr_lines = biz.address|split("\n")|map(l => l|trim)|filter(l => l) %}
        {% set ticker = addr_lines|merge(['KK.CONTACT.SEE_YOU'|t, 'Kaffe', 'Kos']) %}
        <div class="ct-ticker" aria-hidden="true">
            <div class="ct-ticker-band">
                <div class="ct-ticker-track">
                    {% for g in 1..2 %}
                        <div class="ct-ticker-group">
                            {% for r in 1..2 %}{% for w in ticker %}<span>{{ w }}</span>{% endfor %}{% endfor %}
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
        <div class="wrap wrap-wide contact-map">
            <div class="ct-map-frame" data-map-frame>
                <iframe title="{{ 'KK.MAP_TITLE'|t }}" loading="lazy" referrerpolicy="no-referrer-when-downgrade"
                    src="https://www.google.com/maps?q={{ biz.lat }},{{ biz.lng }}&amp;z=16&amp;output=embed"></iframe>
                <span class="ct-map-pulse" aria-hidden="true"><i></i><i></i></span>
                <button type="button" class="ct-map-activate" data-map-activate hidden><span class="ct-map-hint">{{ kk.icon('pin', 18) }} {{ 'KK.CONTACT.MAP_HINT'|t }}</span></button>
            </div>
            <div class="ct-address">
                <span class="ct-address-tag">{{ 'KK.CONTACT.PIN_DROPPED'|t }}</span>
                <h2>{{ kk.icon('pin', 24) }} {{ c.info_title ?: 'KK.FIND_US'|t }}</h2>
                <p>{{ biz.address|e('html')|nl2br }}</p>
                {% if biz.directions_note %}<p class="ct-note">{{ biz.directions_note|e('html')|nl2br }}</p>{% endif %}
                <p class="open-badge open-badge-dark" data-open-status><span class="dot"></span><span data-open-text></span></p>
                <div class="ct-address-actions">
                    {% if biz.maps_url %}<a class="btn btn-primary" href="{{ biz.maps_url }}" target="_blank" rel="noopener">{{ 'KK.GET_DIRECTIONS'|t }} {{ kk.icon('arrow', 18) }}</a>{% endif %}
                    <button type="button" class="btn btn-outline" data-copy="{{ addr_lines|join(', ')|e('html_attr') }}" data-copied="{{ 'KK.CONTACT.COPIED'|t|e('html_attr') }}" hidden>{{ 'KK.CONTACT.COPY'|t }}</button>
                </div>
            </div>
        </div>
    {% endif %}
</section>
{% endblock %}
